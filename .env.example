# Local development only. Never prefix secrets with NEXT_PUBLIC_.
AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Google Cloud OAuth client type: Web application
# Authorized redirect URI: http://localhost:3000/api/auth/callback

# Public read only; restrict this API key to Google Sheets API.
GOOGLE_SHEETS_API_KEY=

# Optional local verification of encrypted Redis sessions. Configure all three together.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
SESSION_ENCRYPTION_KEY=
